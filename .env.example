# Starter CLI: giữ fake cho đến khi workflow AI được tích hợp và kiểm thử.
MODEL_PROVIDER=fake
MODEL_NAME=lfm3-1.7b
API_KEY=
# Liquid direct API: chỉ sử dụng khi MODEL_PROVIDER=liquid.
LIQUID_API_KEY=
# Dành cho tích hợp đánh giá và quan sát trong tương lai.
TYPESAFE_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Cấu hình công khai được backend cung cấp qua /api/config.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Snapshot tổng hợp, không phải dữ liệu CSV gốc.
AGGREGATE_SNAPSHOT_PATH=data/aggregate.json
# Snapshot v2 cho dashboard/báo cáo; bỏ trống thì backend dùng aggregate.v2.json cùng thư mục AGGREGATE_SNAPSHOT_PATH.
AGGREGATE_SNAPSHOT_V2_PATH=data/aggregate.v2.json
